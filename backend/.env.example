# Copy to `.env` and fill in. Never commit `.env`.

ENVIRONMENT=local
LOG_LEVEL=INFO

# asyncpg driver: note the "+asyncpg" part of the scheme
DATABASE_URL=postgresql+asyncpg://airadar:airadar@localhost:5432/airadar

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

APP_BASE_URL=http://localhost:3000

# Needed from Milestone 4 / 7
GITHUB_TOKEN=
RESEND_API_KEY=
